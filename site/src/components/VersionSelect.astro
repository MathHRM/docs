---
import Dropdown from './Dropdown.astro';
import { versions } from '../versions.json';
import { docsPath, routeParts } from '../utils/docs-routes';

const { locale, version: selected, page } = routeParts(Astro.url.pathname);
const versionLabels: Record<string, string> = {
  en: 'Laravel version',
  'pt-br': 'Versão do Laravel',
  es: 'Versión de Laravel',
};
const items = versions.map(({ label, version }) => ({
  label,
  href: docsPath(locale, version, page),
  current: version === selected,
}));
---

<Dropdown
  label={`v${selected}`}
  accessibleLabel={versionLabels[locale] || versionLabels.en}
  items={items}
/>
